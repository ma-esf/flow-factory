#!/usr/bin/env bash
#
# Flow Factory install: places the factory on this machine, and updates it.
#
#   ./install
#   ./install --init <project root> <answers file>
#   ./install --check <project root> <answers file>
#
# Run it from a checkout of the factory. It copies the skills into
# ~/.claude/skills/ and the contracts into ~/.flow-factory/, and asks nothing.
# Run it again to update: it pulls the checkout first.
#
# --init fits one project on a machine that has the factory: it writes the
# project's flow-factory.toml from an answers file, creates its tracker and
# keeps both out of git. README.md, "Fit a project", shows an answers file.
# --check reads the same answers, leaves the project and the record untouched,
# and prints the project's gaps, which --init also prints once it has written.

set -euo pipefail

# An inherited CDPATH makes cd print the directory, which a $(cd ... && pwd)
# then captures along with the path.
unset CDPATH

FACTORY_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# An unmatched glob must expand to nothing, not to itself. A literal `*` that
# survives reaches rm and cp as a filename.
shopt -s nullglob

# One spelling of HOME, so the paths in the record match from run to run.
HOME=$(cd -- "$HOME" && pwd -P) \
    || { printf 'FAILED: cannot enter HOME\n' >&2; exit 1; }

MACHINE_DIR="$HOME/.flow-factory"
SKILLS_DIR="$HOME/.claude/skills"

# The record of this install, which update, uninstall and the removal of
# withdrawn skills read. One `<field> <value>` per line, the value running to
# the end of the line, so grep, sed and awk read it and no skill needs jq:
#
#   version <factory_stamp>
#   checkout <absolute path of this checkout>
#   mode copy
#   file <absolute path of a placed file>        one per file
#   project <absolute path of a project root>    one per initialised project
RECORD="$MACHINE_DIR/install-record.txt"

say()  { printf '%s\n' "$*"; }
step() { printf '\n== %s\n' "$*"; }
fail() { printf '\nFAILED: %s\n' "$*" >&2; exit 1; }

USAGE="usage: ./install, or ./install --init|--check <project root> <answers file>"
MODE=machine
if [ $# -gt 0 ]; then
    case $1 in --init) MODE=init ;; --check) MODE=check ;; *) fail "$USAGE" ;; esac
    [ $# -eq 3 ] || fail "$USAGE"
    PROJECT_ARG=$2; ANSWERS_ARG=$3
fi

# ---------------------------------------------------------------------------
# The version stamp
#
# The factory ships in numbered releases, and a release is a tag. So the stamp
# asks git what release this tree is, rather than naming the commit and leaving
# the reader to work it out: `v0.1.0` on the tagged commit, `v0.1.0-3-g47cd209`
# three commits past it. Both answers say which release you have, and the
# second says how far past it you are, which a bare hash never did.
#
# --always keeps an untagged tree working: before the first tag, and in a
# shallow clone that fetched no tags, describe falls back to the short hash.
#
# A dirty tree is stamped, not refused: the record's job is to say what was
# actually placed, and a run from a dirty tree places files no commit holds.
# Refusing would also stop the installer installing its own uncommitted
# changes, the state every change to the factory passes through. The count
# covers the directories named as arguments, the ones the run places from, and
# comes from status rather than describe --dirty, because status counts
# untracked files too, and a new skill nobody has added yet is the likeliest
# way this tree differs from its tag.
# ---------------------------------------------------------------------------
factory_stamp() {
    local release dirty
    release=$(git -C "$FACTORY_ROOT" describe --tags --always) \
        || fail "git cannot say which version $FACTORY_ROOT is; its message is above"
    dirty=$(git -C "$FACTORY_ROOT" status --porcelain -- "$@" | wc -l | tr -d ' ')
    if [ "$dirty" -eq 0 ]; then
        printf '%s' "$release"
    else
        printf '%s plus uncommitted changes to %s files' "$release" "$dirty"
    fi
}

# The stops for a factory that cannot be placed correctly. Every one runs
# before the first write, so a stopped run leaves HOME as it was.
#
# Claude Code is absent when ~/.claude is absent, not when skills/ is. A user
# who has never added a skill has the first and not the second.
[ -d "$HOME/.claude" ] \
    || fail "no ~/.claude. Claude Code was not found on this machine."
command -v git >/dev/null 2>&1 \
    || fail "git is not on PATH. The factory needs git to say which version it placed."
# A linked ~/.flow-factory points somewhere this installer does not own, so
# nothing, not even the record, is written through it.
[ ! -L "$MACHINE_DIR" ] \
    || fail "~/.flow-factory is a link. Nothing is written through it; move it aside and run again."
for required in machine skills; do
    [ -d "$FACTORY_ROOT/$required" ] \
        || fail "$FACTORY_ROOT is not a factory checkout: no $required/"
done

# ---------------------------------------------------------------------------
# The update
#
# A second ./install is how a machine takes a new factory version, so machine
# mode pulls first. Fast-forward only, so it never makes a merge commit. A
# pull that cannot, on a diverged or detached checkout or one with no
# upstream, leaves the files as they are, so it does not stop the install.
#
# bash goes on running the text it started with after the pull replaces this
# file, so a pull that moved HEAD hands over to the pulled installer.
# FLOW_FACTORY_PULLED keeps that run from pulling again. A stop in that run
# leaves the checkout pulled and HOME as it was.
# ---------------------------------------------------------------------------
update_checkout() {
    local before from rc=0 msg
    # A factory copied into another repository has no checkout of its own,
    # and a pull there would move that repository.
    if [ "$(git -C "$FACTORY_ROOT" rev-parse --show-toplevel 2>/dev/null || true)" \
            != "$(cd -- "$FACTORY_ROOT" && pwd -P)" ]; then
        say "  not pulled: the factory is not the top level of a checkout, so it is installed as it stands"
        return 0
    fi
    before=$(git -C "$FACTORY_ROOT" rev-parse -q --verify HEAD || true)
    from=$(git -C "$FACTORY_ROOT" describe --tags --always 2>/dev/null || true)
    # --no-rebase, because before git 2.34 pull.rebase overrides --ff-only.
    msg=$(GIT_TERMINAL_PROMPT=0 git -C "$FACTORY_ROOT" pull --ff-only --no-rebase -q 2>&1) || rc=$?
    # HEAD, not the exit code, says whether the tree changed: a pull can land
    # and still fail afterwards, in a hook.
    if [ "$(git -C "$FACTORY_ROOT" rev-parse -q --verify HEAD || true)" != "$before" ]; then
        say "  pulled $from to $(git -C "$FACTORY_ROOT" describe --tags --always)"
        [ "$rc" -eq 0 ] || printf '%s\n' "$msg" | sed 's/^/    /'
        [ -f "$FACTORY_ROOT/install" ] \
            || fail "the pull left no install in $FACTORY_ROOT, so nothing was installed"
        FLOW_FACTORY_PULLED=1 exec "$BASH" "$FACTORY_ROOT/install"
    elif [ "$rc" -eq 0 ]; then
        say "  the checkout is up to date"
    else
        say "  the pull failed, so the checkout is installed as it stands:"
        printf '%s\n' "$msg" | sed 's/^/    /'
    fi
}
if [ "$MODE" = machine ] && [ -z "${FLOW_FACTORY_PULLED:-}" ]; then
    step "Update the checkout"
    update_checkout
fi

# Project mode places from project/, machine mode from skills/ and machine/.
# --check needs no stamp, and the stamp's git status can rewrite the factory
# checkout's index.
if [ "$MODE" = init ]; then
    STAMP=$(factory_stamp project) || exit 1
elif [ "$MODE" = machine ]; then
    STAMP=$(factory_stamp skills machine) || exit 1
fi

# ===========================================================================
# Project mode: ./install --init|--check <project root> <answers file>
#
# Branches off here, before the machine steps, so it never places a skill or
# rewrites a machine file. As in machine mode, every stop runs before the first
# write, so a stopped run leaves the project and the record as they were. A
# write that fails partway is not a stop: each write is skipped once done, so a
# rerun completes the rest. --check runs the same stops and ends before the
# first write.
# ===========================================================================

TEMPLATE="$FACTORY_ROOT/project/flow-factory.toml"
README_TEMPLATE="$FACTORY_ROOT/project/.cortex/README.md"

# A TOML string in double quotes, holding only the escapes TOML defines.
# Inside brackets a backslash is literal, so [^"\\] is any character but a
# quote or a backslash.
TOML_STRING='"([^"\\]|\\([btnfr"\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}))*"'
STRING_RE="^$TOML_STRING\$"
LIST_RE='^\[[[:space:]]*('"$TOML_STRING"'([[:space:]]*,[[:space:]]*'"$TOML_STRING"')*[[:space:]]*,?)?[[:space:]]*\]$'
ANSWER_RE='^[[:space:]]*([A-Za-z0-9_.-]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*$'
SKIP_RE='^[[:space:]]*(#.*)?$'
# Digits with at most one {NN}, the suffix /flow-run-app fills in.
PORT_RE='^[0-9]*(\{NN\})?[0-9]*$'

# The value of key $1 in settings file $2, as written.
key_value() {
    K="$1" awk 'index($0, ENVIRON["K"] " = ") == 1 {
        print substr($0, length(ENVIRON["K"]) + 4); exit }' "$2"
}

# The elements of a TOML list of strings, one per line, quotes kept.
list_items() { grep -oE "$TOML_STRING" <<< "$1" || true; }
list_length() { list_items "$(key_value "$1" "$2")" | grep -c . || true; }

# Write one key's value, already in TOML form, into settings file $3.
set_key() {
    K="$1" V="$2" awk 'index($0, ENVIRON["K"] " = ") == 1 && !done {
            print ENVIRON["K"] " = " ENVIRON["V"]; done = 1; next }
        { print }' "$3" > "$3.new"
    mv -- "$3.new" "$3"
}

# The first branch or tag whose tree holds path $2 of repository $1 as
# anything. One cat-file answers every ref; its output lines pair with the refs
# by position, because a path may hold spaces and the ref names cannot. A
# missing path prints the input, never a type, in the first field.
committed_on() {
    local refs
    refs=$(git -C "$1" for-each-ref --format='%(refname)' refs/heads refs/remotes refs/tags)
    [ -n "$refs" ] || return 0
    printf '%s\n' "$refs" \
        | P="$2" awk '{ print $0 ":" ENVIRON["P"] }' \
        | git -C "$1" cat-file --batch-check='%(objecttype)' \
        | paste -d ' ' - <(printf '%s\n' "$refs") \
        | awk '$1 ~ /^(blob|tree|commit)$/ && !n++ { print $2 }'
}

# Queue the exclude pattern for path $3 of root $1, whose prefix below the top
# level is $2, unless the project tracks the path here or commits it on any
# branch or tag. An exclude line does not untrack a file. And git treats an
# excluded path as expendable, so a checkout of a ref that commits it, even as
# a symlink, overwrites or deletes it without a word: the settings, or every
# ticket.
queue_exclude() {
    local on
    if [ -n "$(git -C "$1" ls-files -- "$3")" ]; then
        say "  not excluded: $3 is tracked, and an exclude line would not untrack it" >> "$WORK/kept"
    elif on=$(committed_on "$1" "$2$3") && [ -n "$on" ]; then
        say "  not excluded: $3 is committed on $on" >> "$WORK/kept"
    else
        say "/$(printf '%s' "$2$3" | sed 's/[][*?\\]/\\&/g')" >> "$WORK/patterns"
    fi
}

# Whether file $1 ends without a newline, which an appended line would join.
ends_open() { [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ]; }

# Whether top level $1 tracks anything under .claude/worktrees/, where
# /flow-worktree-create makes the worktrees. Only this checkout's index
# counts: a worktree another branch committed is the accident the exclude
# line prevents.
worktrees_tracked() { [ -n "$(git -C "$1" ls-files -- .claude/worktrees/)" ]; }

# The skills each gap breaks, and how.
ORIGIN_LOSES="/flow-close-out, /flow-comments-review, /flow-pr-summary, /flow-worktree-close and /flow-worktree-create error, /flow-status and /flow-reground stop"
NETWORK_LOSES="/flow-close-out, /flow-comments-review, /flow-new-github-issue, /flow-pr-summary, /flow-ship-ticket, /flow-stakeholder-update, /flow-worktree-close and /flow-worktree-create error, /flow-status and /flow-reground stop"
GH_LOSES="/flow-close-out, /flow-comments-review, /flow-new-github-issue, /flow-pr-summary, /flow-ship-ticket and /flow-stakeholder-update"

# Run "$@", and kill it after 10 seconds, saying so on stderr, so a network
# that drops packets fails a check instead of hanging it. The reason is said
# before the kill, which wakes the caller. The sleep holds no output, or a
# caller's $(...) would wait for it, and dies with the watcher.
NO_ANSWER="no answer in 10 seconds"
bounded() {
    local pid watcher rc=0
    "$@" &
    pid=$!
    (
        s=""
        trap 'kill "$s" 2>/dev/null; exit' TERM
        sleep 10 >/dev/null 2>&1 &
        s=$!
        wait "$s"
        say "$NO_ANSWER" >&2
        kill "$pid" 2>/dev/null
    ) &
    watcher=$!
    # bash 3.2 says on stderr that a killed command was killed, which would
    # take the place of the reason. The command's own stderr is not wait's.
    wait "$pid" 2>/dev/null || rc=$?
    kill "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
    return "$rc"
}

# origin's URL $1 as gh names a repository, HOST/OWNER/REPO. gh parses
# neither an ssh host alias nor a user other than git@, and with no argument
# picks upstream before origin. Any user or token in the URL is dropped, and
# an ssh host is resolved from the config of ssh command $2, which ssh -G
# reads without connecting. Fails on a path, which no gh host serves.
gh_repo() {
    local u=${1%/} host via_ssh="" resolved=""
    u=${u%.git}
    case $u in
        file://*) return 1 ;;
        ssh://*) host=${u#*://}; host=${host%%/*}; via_ssh=yes ;;
        *://*) host=${u#*://}; host=${host%%/*} ;;
        *:*) host=${u%%:*}; via_ssh=yes
             case $host in */*) return 1 ;; esac ;;
        *) return 1 ;;
    esac
    host=${host##*@}; host=${host%%:*}
    if [ -n "$via_ssh" ]; then
        resolved=$(bounded sh -c "$2"' -o BatchMode=yes -G "$1"' ssh "$host" 2>/dev/null \
            | awk '$1 == "hostname" { print $2; exit }')
    fi
    host=${resolved:-$host}
    # As gh does, any *.github.com host, such as ssh-over-443's ssh.github.com,
    # is github.com.
    case $host in *.github.com) host=github.com ;; esac
    printf '%s/%s\n' "$host" "$(printf '%s\n' "$u" | awk -F'[/:]' '{ print $(NF-1) "/" $NF }')"
}

# The gaps of project root $1 for default branch $2, one line each: what is
# missing, the skills that lose, and the fix where there is one. Reads only,
# and never stops on a gap.
project_gaps() {
    local root=$1 branch=$2 top rc ssh="" why url repo skip="" perm what have label
    local labels
    top=$(git -C "$root" rev-parse --show-toplevel)
    labels=$(list_items "$(key_value github.labels "$WORK/settings")")
    # No origin is every origin gap at once, so it costs what an unreachable
    # one does.
    if ! url=$(git -C "$root" remote get-url origin 2>/dev/null); then
        say "no origin: $NETWORK_LOSES. Fix: git remote add origin <url>"
        skip="there is no origin"
    else
        # Prompts off, so a missing repository fails instead of asking for a
        # password. GIT_TERMINAL_PROMPT=0 does not stop an askpass program,
        # which an editor's terminal sets, nor Git Credential Manager's
        # sign-in window. ssh gets no prompt, a connect timeout of its own,
        # and no rewrite of known_hosts. The project's own ssh command is
        # kept, since GIT_SSH_COMMAND overrides core.sshCommand, and so is
        # GIT_SSH, a program that may take no ssh options: ssh stays empty.
        ssh=${GIT_SSH_COMMAND:-$(git -C "$root" config core.sshCommand || true)}
        [ -n "$ssh" ] || [ -n "${GIT_SSH:-}" ] || ssh=ssh
        # stderr goes to a file, not a pipe: a killed git leaves its ssh
        # running, which would hold a pipe open until ssh gives up.
        rc=0
        (
            export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS= GCM_INTERACTIVE=never
            [ -z "$ssh" ] \
                || export GIT_SSH_COMMAND="$ssh -o BatchMode=yes -o ConnectTimeout=5 -o UpdateHostKeys=no"
            bounded git -C "$root" ls-remote --exit-code origin "refs/heads/$branch" \
                >/dev/null 2>"$WORK/git-error"
        ) || rc=$?
        # The reason is the last line before git's own closing lines, which
        # come after ssh's failure and any warnings ssh printed first. An ssh
        # that failed without a word leaves git's first line, or the code.
        why=$(sed '/^fatal: Could not read from remote repository\.$/,$d' "$WORK/git-error" \
            | grep . | tail -n 1 || true)
        why=${why:-$(head -n 1 "$WORK/git-error")}
        why=${why:-git ls-remote exited $rc}
        case $rc in
            0) ;;
            2) say "origin has no branch $branch: $ORIGIN_LOSES. Fix: git push origin $branch" ;;
            *) say "origin cannot be reached, $why: $NETWORK_LOSES" ;;
        esac
    fi

    # Untracked, it is left to the exclude line --init writes.
    ! worktrees_tracked "$top" \
        || say ".claude/worktrees/ is tracked: /flow-worktree-create is wrong, git add -A in the main checkout stages each worktree. Fix: git -C \"$top\" rm -r --cached .claude/worktrees/"

    # Whether gh is there and logged in is the machine's gap, not this
    # project's, so it is skipped here and named. The login is checked for
    # origin's host only, since a broken one elsewhere is not this project's.
    # gh auth status fails offline too, so the reason names the command, not
    # a login.
    [ -n "$skip" ] || command -v gh >/dev/null 2>&1 || skip="gh is not installed"
    # Under GIT_SSH, ssh is empty, and plain ssh reads the config.
    if [ -z "$skip" ] && ! repo=$(gh_repo "$url" "${ssh:-ssh}"); then
        say "gh cannot reach origin, which is a path: every gh step fails, in $GH_LOSES"
        [ -z "$labels" ] || say "not checked: the labels, because gh cannot reach origin"
        return 0
    fi
    [ -n "$skip" ] || bounded gh auth status --hostname "${repo%%/*}" >/dev/null 2>&1 \
        || skip="gh auth status fails for ${repo%%/*}"
    what="gh reaching origin"
    [ -z "$labels" ] || what="$what, and the labels"
    if [ -n "$skip" ]; then
        say "not checked: $what, because $skip"
        return 0
    fi
    if ! perm=$(bounded gh repo view "$repo" --json viewerPermission -q .viewerPermission 2>"$WORK/gh-error"); then
        say "gh cannot reach origin, $(head -n1 "$WORK/gh-error"): every gh step fails, in $GH_LOSES"
        [ -z "$labels" ] || say "not checked: the labels, because gh cannot reach origin"
        return 0
    fi
    case $perm in
        ADMIN|MAINTAIN|WRITE) ;;
        *) say "you cannot push to origin, gh reports ${perm:-no permission}: /flow-ship-ticket errors, and /flow-worktree-close cannot delete the remote branch. Fix: ask a repository admin for write access" ;;
    esac

    # Each name JSON-encoded, which is the TOML string the answers hold,
    # quotes and backslashes included, unless they spell a character as \u.
    # Matched ignoring case, as GitHub matches label names. gh lists 30
    # labels unless given a limit.
    [ -n "$labels" ] || return 0
    if ! have=$(bounded gh label list --repo "$repo" --limit 1000 --json name -q '.[].name | tojson' 2>"$WORK/gh-error"); then
        say "not checked: the labels, because gh label list failed, $(head -n1 "$WORK/gh-error")"
        return 0
    fi
    while IFS= read -r label; do
        grep -qixF -- "$label" <<< "$have" \
            || say "label $label does not exist on origin: /flow-new-github-issue errors. Fix: gh label create $label --repo $repo"
    done <<< "$labels"
}

# The gaps, or one line saying there are none, so a clean check does not read
# as one that never ran.
check_project() {
    local gaps
    gaps=$(project_gaps "$@")
    say "${gaps:-no gaps}"
}

init_project() {
    local root prefix top git_common exclude line n key value tmpl item port
    local services commands ports branch pattern verb d

    [ -f "$RECORD" ] \
        || fail "the factory is not installed on this machine: no ~/.flow-factory/install-record.txt. Run ./install first."
    [ -f "$TEMPLATE" ] && [ -f "$README_TEMPLATE" ] \
        || fail "$FACTORY_ROOT is not a factory checkout: no project/flow-factory.toml or project/.cortex/README.md"
    [ -d "$PROJECT_ARG" ] || fail "no such directory: $PROJECT_ARG"
    root=$(cd -- "$PROJECT_ARG" && pwd -P)
    [ "$(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] \
        || fail "$root is not a git repository, or is one with no work tree"
    git -C "$root" rev-parse --verify -q HEAD >/dev/null \
        || fail "$root has no commit. Every skill that runs git needs one; commit first."
    # cd and pwd, not --path-format=absolute, which git before 2.31 echoes back.
    git_common=$(cd -- "$root" && cd -- "$(git rev-parse --git-common-dir)" && pwd -P) \
        || fail "cannot find the git directory of $root"
    # A linked worktree is not a project root: `git worktree remove` deletes
    # what is written there, tickets included, without asking.
    [ "$(cd -- "$root" && cd -- "$(git rev-parse --git-dir)" && pwd -P)" = "$git_common" ] \
        || fail "$root is in a linked worktree. Run --$MODE on the main checkout, $(git -C "$root" worktree list --porcelain | sed -n '1s/^worktree //p')"
    [ -f "$ANSWERS_ARG" ] && [ -r "$ANSWERS_ARG" ] || fail "cannot read the answers file $ANSWERS_ARG"
    SETTINGS="$root/flow-factory.toml"
    [ ! -e "$SETTINGS" ] || [ -f "$SETTINGS" ] || fail "$SETTINGS exists and is not a file"
    [ ! -e "$root/.cortex" ] || [ -d "$root/.cortex" ] || fail "$root/.cortex exists and is not a directory"

    # PENDING names a temporary file this run made, and only while it exists,
    # so a stop never deletes a file that is not its own.
    WORK=$(mktemp -d)
    PENDING=""
    trap 'rm -rf -- "$WORK"; [ -z "$PENDING" ] || rm -f -- "$PENDING"' EXIT

    # The answers, written over a copy of the template, which carries the
    # comments and the unset: tag of every key. A key the answers leave out
    # keeps the template's line.
    cp -- "$TEMPLATE" "$WORK/settings"
    : > "$WORK/answered"
    n=0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        [[ ! $line =~ $SKIP_RE ]] || continue
        [[ $line =~ $ANSWER_RE ]] \
            || fail "line $n of the answers file is not 'key = value': $line"
        key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
        tmpl=$(key_value "$key" "$TEMPLATE")
        [ -n "$tmpl" ] || fail "unknown key '$key' in the answers file. Its keys are the template's, project/flow-factory.toml"
        ! grep -qxF -- "$key" "$WORK/answered" || fail "key '$key' appears twice in the answers file"
        # The template's value says the key's kind.
        case $tmpl in
            \"*) [[ $value =~ $STRING_RE ]] \
                    || fail "malformed value for '$key': expected a string in double quotes, got $value" ;;
            \[*) [[ $value =~ $LIST_RE ]] \
                    || fail "malformed value for '$key': expected a list of strings in square brackets, got $value" ;;
            *)   [[ $value =~ ^(true|false)$ ]] \
                    || fail "malformed value for '$key': expected true or false, got $value" ;;
        esac
        case $key in
            pr.create_mode)
                case $value in '"manual"'|'"gh"') ;;
                    *) fail "'pr.create_mode' must be \"manual\" or \"gh\", got $value" ;; esac ;;
            github.attribution)
                case $value in '"none"'|'"tool"') ;;
                    *) fail "'github.attribution' must be \"none\" or \"tool\", got $value" ;; esac ;;
            app.ports)
                # In range for the smallest suffix, 20, and the largest, 99. At
                # most five digits first, so the comparison never meets a
                # number too long for it.
                while IFS= read -r item; do
                    item=${item#\"}; item=${item%\"}
                    port=${item//\{NN\}/99}
                    [ -n "$item" ] && [[ $item =~ $PORT_RE ]] && [ "${#port}" -le 5 ] \
                        && [ "$port" -le 65535 ] && [ "${item//\{NN\}/20}" -ge 1 ] \
                        || fail "bad port \"$item\" in 'app.ports': digits, with {NN} for the suffix, from 1 to 65535, for example 80{NN}"
                done < <(list_items "$value") ;;
        esac
        set_key "$key" "$value" "$WORK/settings"
        printf '%s\n' "$key" >> "$WORK/answered"
    done < "$ANSWERS_ARG"

    # One entry per service in each of the three lists, so the lists pair up
    # by position.
    services=$(list_length app.services "$WORK/settings")
    commands=$(list_length app.start_commands "$WORK/settings")
    ports=$(list_length app.ports "$WORK/settings")
    [ "$services" -eq "$commands" ] && [ "$services" -eq "$ports" ] \
        || fail "'app.services', 'app.start_commands' and 'app.ports' must be the same length, one entry per service; they have $services, $commands and $ports"

    branch=$(key_value git.default_branch "$WORK/settings")
    branch=${branch#\"}; branch=${branch%\"}
    git -C "$root" show-ref --verify -q "refs/heads/$branch" \
        || git -C "$root" show-ref --verify -q "refs/remotes/origin/$branch" \
        || fail "'git.default_branch' is \"$branch\", which names neither a local branch nor origin/$branch"

    # Nothing above writes outside $WORK, so --check ends here.
    if [ "$MODE" = check ]; then
        check_project "$root" "$branch"
        return 0
    fi

    # The exclude lines. info/exclude, never the tracked .gitignore, and in the
    # common git directory, so one line covers every worktree. No trailing
    # slash on .cortex: git does not treat a symlink as a directory, so
    # `/.cortex/` misses every worktree's link. Both lines are anchored at the
    # top level, so a project root below it carries its prefix.
    prefix=$(git -C "$root" rev-parse --show-prefix)
    top=$(git -C "$root" rev-parse --show-toplevel)
    exclude="$git_common/info/exclude"
    : > "$WORK/patterns"; : > "$WORK/kept"
    queue_exclude "$root" "$prefix" .cortex
    queue_exclude "$root" "$prefix" flow-factory.toml
    # The worktrees sit under the top level whatever the root.
    if worktrees_tracked "$top"; then
        say "  not excluded: .claude/worktrees/ is tracked, and an exclude line would not untrack it" >> "$WORK/kept"
    else
        say "/.claude/worktrees/" >> "$WORK/patterns"
    fi

    # Name every path written before writing any of them.
    say "This init writes only these paths:"
    say "  $SETTINGS"
    say "  $root/.cortex/"
    say "  $exclude"
    say "  ~/.flow-factory/install-record.txt"

    step "Write flow-factory.toml"
    if [ -f "$SETTINGS" ] && cmp -s "$WORK/settings" "$SETTINGS"; then
        say "  unchanged flow-factory.toml"
    else
        verb=wrote
        [ ! -e "$SETTINGS" ] || verb=OVERWROTE
        # Copied beside the target, so the move is a rename and never a
        # partial copy.
        PENDING="$SETTINGS.tmp.$$"
        cp -- "$WORK/settings" "$PENDING"
        mv -- "$PENDING" "$SETTINGS"
        PENDING=""
        say "  $verb flow-factory.toml, $(grep -c . "$WORK/answered" || true) keys from the answers file"
    fi

    step "Create the tracker in .cortex/"
    for d in tickets candidates; do
        if [ -d "$root/.cortex/$d" ]; then
            say "  unchanged .cortex/$d/"
        else
            mkdir -p "$root/.cortex/$d"
            say "  created   .cortex/$d/"
        fi
    done
    # Stamped once. The date is the install's, so a rerun keeps it. Built
    # beside the target and moved, so a failed build leaves no README for a
    # rerun to mistake for a finished one.
    if [ -e "$root/.cortex/README.md" ]; then
        say "  unchanged .cortex/README.md"
    else
        PENDING="$root/.cortex/README.md.tmp.$$"
        V="$STAMP" D="$(date +%Y-%m-%d)" awk '
            function fill(s, from, to,   i) {
                while ((i = index(s, from)) > 0)
                    s = substr(s, 1, i - 1) to substr(s, i + length(from))
                return s
            }
            { print fill(fill($0, "<factory version>", ENVIRON["V"]), "<YYYY-MM-DD>", ENVIRON["D"]) }
        ' "$README_TEMPLATE" > "$PENDING"
        mv -- "$PENDING" "$root/.cortex/README.md"
        PENDING=""
        say "  wrote     .cortex/README.md, Flow Factory $STAMP"
    fi

    step "Keep the factory's files out of git"
    mkdir -p "$git_common/info"
    while IFS= read -r pattern; do
        if [ -f "$exclude" ] && grep -qxF -- "$pattern" "$exclude"; then
            say "  unchanged $pattern in $exclude"
        else
            {
                if ends_open "$exclude"; then printf '\n'; fi
                printf '%s\n' "$pattern"
            } >> "$exclude" || fail "cannot write $exclude"
            say "  excluded  $pattern in $exclude"
        fi
    done < "$WORK/patterns"
    cat "$WORK/kept"
    [ -z "$prefix" ] \
        || say "  $root is not the repository's top level, so worktrees do not share this tracker"

    step "Record the project"
    if grep -qxF -- "project $root" "$RECORD"; then
        say "  unchanged ~/.flow-factory/install-record.txt, which lists $root"
    else
        PENDING="$RECORD.tmp"
        {
            cat -- "$RECORD"
            if ends_open "$RECORD"; then printf '\n'; fi
            say "project $root"
        } > "$PENDING"
        mv -- "$PENDING" "$RECORD"
        PENDING=""
        say "  recorded  $root in ~/.flow-factory/install-record.txt"
    fi

    step "Check the project"
    check_project "$root" "$branch" | sed 's/^/  /'

    say ""
    say "Project fitted."
}

if [ "$MODE" != machine ]; then
    init_project
    exit 0
fi

# What the factory ships: every file under skills/ and machine/ that git
# tracks, or holds untracked and does not ignore, less the .gitkeep
# placeholders and any tracked file deleted from this tree. The same paths and
# ignore rules as the stamp's count, so nothing is placed that the stamp would
# not count.
# -z, because without it git quotes a name holding a quote or a backslash, and
# the quoted name matches no file.
SOURCES=$(git -C "$FACTORY_ROOT" \
        ls-files -z --cached --others --exclude-standard -- skills machine \
    | while IFS= read -r -d '' rel; do
        [ "${rel##*/}" != .gitkeep ] || continue
        if [ -f "$FACTORY_ROOT/$rel" ]; then printf '%s\n' "$rel"; fi
    done | sort -u)
SHIPPED=$(printf '%s\n' "$SOURCES" | sed -n 's|^skills/\([^/]*\)/.*|\1|p' | sort -u)
ships() { grep -qxF -- "$1" <<< "$SHIPPED"; }

# Name every path written outside this checkout before writing any of them.
say "This install writes only these paths outside the checkout:"
say "  ~/.claude/skills/flow-*"
say "  ~/.flow-factory/"

WORK=$(mktemp -d)
trap 'rm -rf -- "$WORK" "$RECORD.tmp"' EXIT

# Claude Code sees new skills without a restart, except when the skills
# directory itself is new.
SKILLS_EXISTED=yes
if [ ! -d "$SKILLS_DIR" ]; then
    SKILLS_EXISTED=no
    mkdir -p "$SKILLS_DIR"
    say ""
    say "  created ~/.claude/skills, which this machine did not have yet"
fi
mkdir -p "$MACHINE_DIR"

# ===========================================================================
# The plan: what this run places and what it leaves alone
#
# Decided in full before anything is placed, so the record can be written
# first. A run cut short then leaves files the record lists, which the next
# run replaces, never files it treats as someone else's.
# ===========================================================================

recorded() {
    [ -f "$RECORD" ] || return 1
    P="file $SKILLS_DIR/$1/" awk 'index($0, ENVIRON["P"]) == 1 { found = 1; exit }
        END { exit !found }' "$RECORD"
}

# A machine file is compared and overwritten, never skipped because it exists:
# a copy left in place can carry an instruction the factory has since
# withdrawn. The exception is a file behind a symlink, itself or a directory
# above it, which may point into someone's checkout, so it is left alone. The
# walk goes down from ~/.flow-factory, which is known not to be a link.
behind_link() { link_above "$MACHINE_DIR" "$1" || [ -L "$MACHINE_DIR/$1" ]; }

# Whether a directory between $1 and the file $1/$2 is a symlink.
link_above() {
    local p=$1 rest=$2
    while [ "${rest#*/}" != "$rest" ]; do
        p="$p/${rest%%/*}"
        [ ! -L "$p" ] || return 0
        rest=${rest#*/}
    done
    return 1
}
: > "$WORK/machine-place"; : > "$WORK/machine-alone"; : > "$WORK/machine-dests"
while IFS= read -r rel; do
    rel=${rel#machine/}
    printf '%s\n' "$MACHINE_DIR/$rel" >> "$WORK/machine-dests"
    if behind_link "$rel"; then
        printf '%s\n' "$rel" >> "$WORK/machine-alone"
    else
        printf '%s\n' "$rel" >> "$WORK/machine-place"
    fi
done < <(printf '%s\n' "$SOURCES" | grep '^machine/')

# A skill directory already on disk is replaced only when the record from an
# earlier run lists it. Anything else there, shipped name or not, is someone's
# own work, and is left alone and named.
: > "$WORK/skills-place"; : > "$WORK/skills-alone"
while IFS= read -r name; do
    [ -n "$name" ] || continue
    if { [ -e "$SKILLS_DIR/$name" ] || [ -L "$SKILLS_DIR/$name" ]; } && ! recorded "$name"; then
        printf '%s\n' "$name" >> "$WORK/skills-alone"
    else
        printf '%s\n' "$name" >> "$WORK/skills-place"
    fi
done <<< "$SHIPPED"
for dest in "$SKILLS_DIR"/flow-*; do
    name=${dest##*/}
    ships "$name" || recorded "$name" || printf '%s\n' "$name" >> "$WORK/skills-alone"
done

# The files of the skills this run places, each skills/<name>/<path>. Matched
# on the name as a string, never as a pattern.
printf '%s\n' "$SOURCES" | awk '
    NR == FNR { place[$0] = 1; next }
    /^skills\// { name = $0; sub(/^skills\//, "", name); sub(/\/.*/, "", name)
                  if (name in place) print }
' "$WORK/skills-place" - > "$WORK/skill-sources"

# Remove every empty directory above file $1, up to but not including $2. A
# lone .DS_Store counts as empty: Finder writes one into any folder it opens.
prune_up() {
    local d
    d=$(dirname -- "$1")
    while [ "${d#"$2"/}" != "$d" ]; do
        [ "$(ls -A -- "$d")" != .DS_Store ] || rm -f -- "$d/.DS_Store"
        rmdir -- "$d" 2>/dev/null || return 0
        d=$(dirname -- "$d")
    done
}

# The files an earlier run placed that the factory no longer ships, removed
# before the record is rewritten, so a run cut short leaves them listed for the
# next. A skill directory that still ships is replaced whole below, so a file
# dropped from it needs nothing here. rm -f on the path removes a file-level
# link and never follows it. A link in a directory above would carry the
# removal into someone's checkout, so a file behind one is left alone, and so
# is a skill directory that is itself a link.
remove_withdrawn() {
    [ -f "$RECORD" ] || return 0
    local path rel name
    : > "$WORK/removed-skills"; : > "$WORK/linked-skills"
    while IFS= read -r path; do
        case $path in
            # A . or .. would carry the removal out of both directories.
            */./*|*/../*)
                tell "  left alone $path, a recorded path holding . or .." ;;
            "$SKILLS_DIR"/*/*)
                rel=${path#"$SKILLS_DIR"/}; name=${rel%%/*}
                ! ships "$name" || continue
                if [ -L "$SKILLS_DIR/$name" ]; then
                    ! grep -qxF -- "$name" "$WORK/linked-skills" || continue
                    printf '%s\n' "$name" >> "$WORK/linked-skills"
                    tell "  left alone $name, no longer shipped, a link this installer does not write through"
                elif drop "$path" "$rel" "$SKILLS_DIR" && ! grep -qxF -- "$name" "$WORK/removed-skills"; then
                    printf '%s\n' "$name" >> "$WORK/removed-skills"
                    tell "  removed $name, no longer shipped"
                fi ;;
            "$MACHINE_DIR"/*)
                ! grep -qxF -- "$path" "$WORK/machine-dests" || continue
                rel=${path#"$MACHINE_DIR"/}
                if drop "$path" "$rel" "$MACHINE_DIR"; then tell "  removed $rel, no longer shipped"; fi ;;
        esac
    done < <(sed -n 's/^file //p' "$RECORD")
    while IFS= read -r name; do
        [ ! -d "$SKILLS_DIR/$name" ] || tell "  kept ~/.claude/skills/$name/, which is not empty"
    done < "$WORK/removed-skills"
}

# Remove withdrawn file $1, named $2, from under directory $3, the skills or
# machine directory. Fails when nothing was removed; a file left alone is
# named.
drop() {
    if link_above "$3" "$2"; then
        tell "  left alone $2, no longer shipped, behind a link this installer does not write through"
    elif [ -d "$1" ] && [ ! -L "$1" ]; then
        tell "  left alone $2, no longer shipped, now a directory this installer did not place"
    elif [ -e "$1" ] || [ -L "$1" ]; then
        # Called as a condition, where set -e does not stop on a failure.
        rm -f -- "$1" || fail "cannot remove $1"
        prune_up "$1" "$3"
        return 0
    fi
    return 1
}

# Each line printed as it happens, so a removal cut short is still named.
TOLD=no
tell() { say "$*"; TOLD=yes; }

step "Remove what the factory no longer ships"
remove_withdrawn
[ "$TOLD" = yes ] || say "  nothing to remove"

# The earlier record's lines this run does not rewrite: every project, and
# every file still on disk outside what this run places. A withdrawn file is
# gone from disk by now, so it drops out; one behind a link stays listed.
carried_lines() {
    [ -f "$RECORD" ] || return 0
    local line path name
    while IFS= read -r line; do
        case $line in
            "project "*) printf '%s\n' "$line" ;;
            "file "*)
                path=${line#file }
                case $path in
                    "$SKILLS_DIR"/*)
                        name=${path#"$SKILLS_DIR"/}; name=${name%%/*}
                        ! grep -qxF -- "$name" "$WORK/skills-place" || continue ;;
                    *)
                        ! grep -qxF -- "$path" "$WORK/machine-dests" || continue ;;
                esac
                # A directory at a recorded path is not a file this run
                # placed, and a record claiming it would let a later run
                # replace it.
                if [ -f "$path" ] || [ -L "$path" ]; then printf '%s\n' "$line"; fi
                ;;
        esac
    done < "$RECORD"
}

step "Record what this run places"
{
    say "version $STAMP"
    say "checkout $FACTORY_ROOT"
    say "mode copy"
    D="$MACHINE_DIR" awk '{ print "file " ENVIRON["D"] "/" $0 }' "$WORK/machine-place"
    D="$SKILLS_DIR" awk '{ print "file " ENVIRON["D"] "/" substr($0, 8) }' "$WORK/skill-sources"
    carried_lines
} > "$RECORD.tmp"
# Built beside the record, so the move is a rename and never a partial copy.
mv -- "$RECORD.tmp" "$RECORD"
say "  recorded  $(grep -c '^file ' "$RECORD" | tr -d ' ') files in ~/.flow-factory/install-record.txt, version $STAMP"

# ===========================================================================
# The placing
# ===========================================================================

step "Place the machine files in ~/.flow-factory/"
while IFS= read -r rel; do
    src="$FACTORY_ROOT/machine/$rel"
    dest="$MACHINE_DIR/$rel"
    mkdir -p "$(dirname -- "$dest")"
    if [ ! -e "$dest" ]; then
        say "  placed    $rel"
    elif cmp -s "$src" "$dest"; then
        say "  unchanged $rel"
    else
        say "  OVERWROTE $rel"
    fi
    cp -- "$src" "$dest"
done < "$WORK/machine-place"
while IFS= read -r rel; do
    say "  left alone $rel, a link this installer does not write through"
done < "$WORK/machine-alone"

step "Copy each skill directory into ~/.claude/skills/"
# Copy, never symlink. find and grep -r take a symlinked directory as an
# argument and do not descend into it, so any later check over the skills
# directory would read nothing and report a pass.
#
# The destination is removed first so a file dropped from a skill does not
# survive the install.
while IFS= read -r name; do
    dest="$SKILLS_DIR/$name"
    if [ -e "$dest" ] || [ -L "$dest" ]; then
        say "  replaced  $name"
        rm -rf -- "$dest"
    else
        say "  installed $name"
    fi
done < "$WORK/skills-place"
while IFS= read -r rel; do
    rel=${rel#skills/}
    mkdir -p "$(dirname -- "$SKILLS_DIR/$rel")"
    cp -- "$FACTORY_ROOT/skills/$rel" "$SKILLS_DIR/$rel"
done < "$WORK/skill-sources"
while IFS= read -r name; do
    say "  left alone $name, which this installer did not place"
done < "$WORK/skills-alone"

# ===========================================================================
# The final check: every reference a placed skill makes resolves
#
# The installer is the only moment a machine is known to be clean, so the
# check runs here rather than in a skill. It reads only the skills this run
# placed: a user's own flow-* skill is not the factory's to fail. A flow-<name>
# reference resolves only when the factory ships <name>, so a stale directory
# of an unshipped name cannot satisfy it.
#
# find -L, because an install that ever links instead of copying would make a
# plain find read nothing and report a pass.
# ===========================================================================

step "Final check. Every reference in a placed skill resolves"

while IFS= read -r name; do
    find -L "$SKILLS_DIR/$name" -type f -print0
done < "$WORK/skills-place" > "$WORK/installed-files"
: > "$WORK/misses"

# A ~/.flow-factory/<path> reference. Trailing sentence punctuation is dropped.
while IFS= read -r ref; do
    [ -e "$HOME/.flow-factory/${ref#\~/.flow-factory/}" ] \
        || printf 'machine file not installed: %s\n' "$ref" >> "$WORK/misses"
done < <(xargs -0 grep -hoE '~/\.flow-factory/[A-Za-z0-9._/-]+' < "$WORK/installed-files" \
    | sed 's/[.,)]$//' | sort -u)

# A flow-<name> reference, with or without the leading slash: skills and docs
# write both. It resolves only when the factory ships <name> and its directory
# is on disk. A dot only makes it a filename when something follows the dot, as
# in flow-worktree-share.txt; a command ending a sentence carries a dot too, and
# treating that as a filename skipped it. A dot before the name makes it a path,
# as in ~/.flow-factory, which the leading class excludes. sed prepends a space
# so a name starting a line has a character before it, which keeps the pattern
# free of a `(^|...)` group; ugrep silently matches nothing for that group.
while IFS= read -r name; do
    ships "$name" && [ -d "$SKILLS_DIR/$name" ] \
        || printf 'skill referenced but not installed: %s\n' "$name" >> "$WORK/misses"
done < <(xargs -0 sed 's/^/ /' < "$WORK/installed-files" \
    | grep -oE '[^A-Za-z0-9._-]flow-[a-z0-9-]+([.][A-Za-z0-9]+)?' \
    | grep -v '\.' | sed 's|^.||' | sort -u)

if [ -s "$WORK/misses" ]; then
    say ""
    cat "$WORK/misses"
    fail "$(wc -l < "$WORK/misses" | tr -d ' ') reference(s) do not resolve on this machine"
fi
if [ -s "$WORK/skills-place" ]; then
    say "  every reference resolves"
else
    say "  no skill was placed by this run, so there was nothing to check"
fi

# ===========================================================================
# The machine check: what the skills need from this machine
#
# One line per gap, in a fixed order: what is missing, the skills that lose
# and how, and the fix where there is one. A gap never stops the install,
# and a check that another gap rules out is named in that gap's line. Every
# call that can wait on a network, a dialog or a startup file is bounded,
# and none reads stdin. A permission or a login is checked here; the
# installer grants neither.
#
# The Claude Code features the skills use have no probe but the version, and
# no minimum version has been measured, so the version is shown, not judged.
# ===========================================================================

step "Check this machine"

CONDUCTOR_LOSES="/flow-conductor stops at its dispatch probes"
WRONG_BASE="/flow-comments-review and /flow-pr-summary diff against the default branch, not the pull request's base"

: > "$WORK/gaps"; : > "$WORK/passed"
GAPS=0
# A check that passed, named, and one that found gap $1. A note is neither:
# a check not run, for a reason that is no gap.
passed() { printf '%s\n' "$1" >> "$WORK/passed"; }
gap()    { GAPS=$((GAPS + 1)); printf '  %s\n' "$1" >> "$WORK/gaps"; }
note()   { printf '  %s\n' "$1" >> "$WORK/gaps"; }
has()    { command -v "$1" >/dev/null 2>&1; }
# The last line of file $1 that is not empty.
reason() { grep . "$1" | tail -n 1 || true; }

# A probe that can wait on a network, a dialog or a startup file, and needs
# no other probe's answer, runs in the background, so the waits overlap.
# Probe $1 leaves its exit code, stdout and stderr in $WORK/$1.rc, .out and
# .why.
PROBES=""
start_probe() {
    local name=$1
    shift
    ( rc=0; bounded "$@" >"$WORK/$name.out" 2>"$WORK/$name.why" || rc=$?; echo "$rc" > "$WORK/$name.rc" ) &
    PROBES="$PROBES $!"
}
probe_passed() { [ -f "$WORK/$1.rc" ] && [ "$(cat "$WORK/$1.rc")" = 0 ]; }

! has claude || start_probe claude-version claude --version
# gh talks to api.github.com, and git to github.com. An HTTP error fails, so
# a proxy's block page is no answer. /rate_limit costs no rate limit, and
# has no HEAD.
if has curl; then
    start_probe web curl -fsSI -o /dev/null --connect-timeout 5 https://github.com
    start_probe api curl -fsS -o /dev/null --connect-timeout 5 https://api.github.com/rate_limit
fi

# Dispatch probes 1 and 3 of ~/.flow-factory/dispatch-prerequisites.md, which
# /flow-conductor runs before its first dispatch. 4 and 2 follow in their
# own places below.
MISSING=""
for tool in osascript defaults; do has "$tool" || MISSING="$MISSING $tool"; done
case $MISSING in
    "") passed "osascript and defaults" ;;
    " defaults") gap "defaults is not installed, so claude in a new pane is not checked: $CONDUCTOR_LOSES" ;;
    " osascript") gap "osascript is not installed, so iTerm2, the Automation permission and claude in a new pane are not checked: $CONDUCTOR_LOSES" ;;
    *) gap "osascript and defaults are not installed, so iTerm2, the Automation permission and claude in a new pane are not checked: $CONDUCTOR_LOSES" ;;
esac
ITERM=""
if has osascript; then
    if bounded osascript -e 'id of application id "com.googlecode.iterm2"' >/dev/null 2>"$WORK/iterm.why"; then
        ITERM=yes
        passed iTerm2
    elif grep -qF "(-1728)" "$WORK/iterm.why"; then
        gap "iTerm2 is not installed, so the Automation permission and claude in a new pane are not checked: $CONDUCTOR_LOSES. Fix: brew install --cask iterm2"
    else
        WHY=$(reason "$WORK/iterm.why")
        gap "osascript cannot say whether iTerm2 is installed, ${WHY:-osascript failed}, so the Automation permission and claude in a new pane are not checked: $CONDUCTOR_LOSES"
    fi
fi
if [ -z "${TMUX:-}" ]; then
    passed "not inside tmux"
else
    gap "this shell is inside tmux: $CONDUCTOR_LOSES there"
fi

# Probe 2, only while iTerm2 is running: the probe would launch it, on every
# update. The first time, macOS may ask the user in a dialog, which the
# bound stops the run waiting for. Asking whether it runs sends it nothing.
RUNNING=""
if [ -n "$ITERM" ]; then
    if ! bounded osascript -e 'application id "com.googlecode.iterm2" is running' >"$WORK/running" 2>"$WORK/running.why"; then
        RUNNING=unknown
    elif [ "$(cat "$WORK/running")" = true ]; then
        RUNNING=yes
        start_probe automation osascript -e 'tell application id "com.googlecode.iterm2" to count windows'
    fi
fi
# Probe 4 runs the shell a new iTerm2 pane runs, with nothing inherited, and
# reads the profile as dispatch-prerequisites.md does. A profile running
# anything else is probed with that command's flags, which only its owner
# knows. script gives the shell a terminal of its own, since an interactive
# shell takes over its terminal's foreground and one killed on the bound
# would leave it there. Killing script hangs up the shell and its children.
PANE=""
if [ -n "$ITERM" ] && has defaults; then
    case $(defaults read com.googlecode.iterm2 "New Bookmarks" 2>/dev/null | grep -m1 '"Custom Command"' || true) in
        ""|*"= No;"*) PANE=login ;;
        *) PANE=custom ;;
    esac
fi
[ "$PANE" != login ] || [ -z "${SHELL:-}" ] \
    || start_probe login-shell \
        script -q /dev/null env -i HOME="$HOME" TERM=xterm "$SHELL" -lic 'command -v claude'
# One process id per word.
wait $PROBES

if ! has claude; then
    say "  claude is not on this shell's PATH, so its version is not shown"
elif probe_passed claude-version; then
    say "  claude --version: $(head -n 1 "$WORK/claude-version.out"), with no minimum version checked"
else
    WHY=$(reason "$WORK/claude-version.why")
    say "  claude --version failed${WHY:+, $WHY}"
fi

if has pbcopy; then
    passed pbcopy
else
    gap "pbcopy is not installed: the copy option in /flow-pr-summary and /flow-ship-ticket errors"
fi

if has gh; then
    passed gh
else
    gap "gh is not installed, so its login is not checked: /flow-close-out, /flow-new-github-issue, /flow-ship-ticket and /flow-stakeholder-update error, and $WRONG_BASE. Fix: brew install gh"
fi

if has lsof; then
    passed lsof
else
    LOSES="/flow-run-app reads every port as free, and so does /flow-verify-delivery through it, and /flow-worktree-close errors"
    if [ -x /usr/sbin/lsof ]; then
        gap "lsof is not on PATH: $LOSES. Fix: add /usr/sbin to PATH"
    else
        gap "lsof is not installed: $LOSES"
    fi
fi

if has curl; then
    passed curl
elif has gh; then
    gap "curl is not installed, so the network to GitHub and the gh login are not checked: /flow-verify-delivery errors. Fix: brew install curl"
else
    gap "curl is not installed, so the network to GitHub is not checked: /flow-verify-delivery errors. Fix: brew install curl"
fi

if PROBE=$(mktemp /tmp/flow-factory-check.XXXXXX 2>/dev/null); then
    rm -f -- "$PROBE"
    passed "mktemp and /tmp"
else
    gap "mktemp cannot make a file in /tmp: /flow-pr-summary and /flow-verify-delivery error"
fi

# In the skills directory, followed if it is a link, or in a plugin installed
# for every project. An install for one project serves only that one, and
# marketplaces/ is never read: it holds every plugin a catalog offers,
# installed or not. The record is read one key per line, as Claude Code
# writes it, so a record in another layout finds nothing and reports a gap.
skill_creator_plugin() {
    local path
    [ -f "$HOME/.claude/plugins/installed_plugins.json" ] || return 1
    while IFS= read -r path; do
        [ ! -f "$path/skills/skill-creator/SKILL.md" ] || return 0
    done < <(awk '
        /"scope"[[:space:]]*:/ { user = ($0 ~ /:[[:space:]]*"user"/) }
        /"installPath"[[:space:]]*:/ {
            path = $0
            sub(/.*"installPath"[[:space:]]*:[[:space:]]*"/, "", path)
            sub(/".*/, "", path)
        }
        /}/ { if (user && path != "") print path; user = 0; path = "" }
    ' "$HOME/.claude/plugins/installed_plugins.json")
    return 1
}
if [ -f "$SKILLS_DIR/skill-creator/SKILL.md" ] || skill_creator_plugin; then
    passed skill-creator
else
    gap "skill-creator is not installed: /flow-fix-agent-behavior errors at its handoff. Fix: claude plugin install skill-creator@claude-plugins-official"
fi

case $PANE in
    login)
        if [ -z "${SHELL:-}" ]; then
            note "not checked: claude in a new pane, because SHELL is not set"
        elif probe_passed login-shell; then
            passed "claude in a new pane"
        elif grep -qxF "$NO_ANSWER" "$WORK/login-shell.why"; then
            note "not checked: claude in a new pane, because the login shell gave $NO_ANSWER"
        else
            gap "claude is not on PATH in the login shell a new iTerm2 pane runs: $CONDUCTOR_LOSES"
        fi ;;
    custom)
        note "not checked: claude in a new pane, because the iTerm2 profile runs a custom command. ~/.flow-factory/dispatch-prerequisites.md says how to probe it" ;;
esac

# gh auth status fails offline too, so the login is asked about only once
# GitHub has answered, and only for the account gh uses on github.com, the
# host that answered: an account failing elsewhere is not this check's gap.
# A project on another host has its login checked by --check. A gh from
# before accounts, with no --active, is asked without it.
gh_login() {
    bounded gh auth status --active --hostname github.com >/dev/null 2>"$WORK/gh.why" && return 0
    grep -qF "unknown flag: --active" "$WORK/gh.why" || return 1
    bounded gh auth status --hostname github.com >/dev/null 2>"$WORK/gh.why"
}
NET=""
if has curl; then
    NET=yes
    for probe in web api; do
        probe_passed "$probe" || { NET=no; WHY=$(reason "$WORK/$probe.why"); break; }
    done
fi
if has gh && [ "$NET" = yes ]; then
    if gh_login; then
        passed "the gh login"
    elif grep -qxF "$NO_ANSWER" "$WORK/gh.why"; then
        note "not checked: the gh login, because gh auth status gave $NO_ANSWER"
    else
        gap "gh is not logged in to github.com: for a project there, /flow-new-github-issue stops, /flow-close-out, /flow-ship-ticket and /flow-stakeholder-update error, and $WRONG_BASE. Fix: gh auth login"
    fi
fi
case $NET in
    yes) passed "the network to GitHub" ;;
    no)
        SKIP=""
        ! has gh || SKIP=", so the gh login is not checked"
        gap "GitHub cannot be reached, ${WHY:-curl failed}$SKIP: for a project there, $NETWORK_LOSES" ;;
esac

if [ "$RUNNING" = unknown ]; then
    WHY=$(reason "$WORK/running.why")
    note "not checked: the Automation permission, because osascript cannot say whether iTerm2 is running, ${WHY:-osascript failed}"
elif [ -n "$ITERM" ] && [ -z "$RUNNING" ]; then
    note "not checked: the Automation permission, because iTerm2 is not running, and the check does not start it"
elif [ -n "$ITERM" ]; then
    if probe_passed automation; then
        passed "the Automation permission"
    else
        WHY=$(reason "$WORK/automation.why")
        FIX="grant it in System Settings, Privacy & Security, Automation"
        [ "$WHY" != "$NO_ANSWER" ] || FIX="answer the macOS dialog if one is open, or $FIX"
        gap "this terminal has no Automation permission for iTerm2, ${WHY:-osascript failed}: $CONDUCTOR_LOSES. Fix: $FIX"
    fi
fi

RAN=$(( $(grep -c . "$WORK/passed" || true) + GAPS ))
if [ "$GAPS" -eq 0 ]; then
    say "  no gaps in $RAN checks: $(paste -s -d , "$WORK/passed" | sed 's/,/, /g')"
elif [ "$GAPS" -eq 1 ]; then
    say "  1 gap in $RAN checks:"
else
    say "  $GAPS gaps in $RAN checks:"
fi
cat "$WORK/gaps"

say ""
say "Install complete."
if [ "$SKILLS_EXISTED" = no ]; then
    say "Next: restart Claude Code first, then fit a project with ./install --init. README.md, \"Fit a project\", shows how."
else
    say "Next: fit a project with ./install --init. README.md, \"Fit a project\", shows how."
fi
# No permission rules are added. That tool proposes them from real use.
say "Once you have used the skills a while, /fewer-permission-prompts proposes permission rules from that use."
