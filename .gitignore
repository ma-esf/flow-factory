# Developer material. This remote carries the product only: the skills, the
# files the installer places, and the installer. Everything about building the
# factory lives in dev/, a plain folder with no repository of its own.
dev/

# The root CLAUDE.md is a symlink into dev/. It has to sit here for the agent
# to read it, and it is developer material like the rest of dev/.
CLAUDE.md

# Agent session state, per machine.
.claude/

# Finder view settings, written into any folder opened on macOS.
.DS_Store

# Python caches, which pytest writes beside a skill's scripts. The installer
# ships every unignored file, and one binary file there silences its final check.
__pycache__/
.pytest_cache/
